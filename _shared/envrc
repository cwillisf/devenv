# shellcheck shell=bash
# Attach a directory to one of the devenv configs next to _shared/. A project's
# .envrc is one line:
#
#   source ~/devenv/_shared/envrc <config> [devenv args...]
#
# for example `source ~/devenv/_shared/envrc scratch3 --profile android`.
#
# An older .envrc that is a symlink to <config>/envrc still works: with no
# arguments, the config is the directory that symlink points into.

export DIRENV_WARN_TIMEOUT=20s

_devenv_self="$(readlink -f -- "${BASH_SOURCE[0]}")"
_devenv_shared="$(dirname -- "$_devenv_self")"
_devenv_configs="$(dirname -- "$_devenv_shared")"
watch_file "$_devenv_self"

if _devenv_link="$(readlink -- "${BASH_SOURCE[0]}")"; then
  # Loaded through a .envrc symlink. direnv passes the .envrc path as $1 here,
  # so it isn't a config name.
  _devenv_config="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd -- "$(dirname -- "$_devenv_link")" && pwd)"
  set --
elif (($#)); then
  _devenv_config="$_devenv_configs/$1"
  shift
else
  log_error "usage: source $_devenv_self <config> [devenv args...]"
  return 1
fi

if [[ ! -f "$_devenv_config/devenv.yaml" ]]; then
  log_error "no devenv.yaml in $_devenv_config"
  return 1
fi

devenv_args=()

watch_file .nvmrc
if [[ -r .nvmrc ]]; then
  devenv_args+=(--option devenv-override.node-major:string "$(sed -E 's/v?([0-9]+).*/\1/' < .nvmrc)")
fi

if [[ "$(pwd -P)" != "$(cd -- "$_devenv_config" && pwd -P)" ]]; then
  devenv_args+=(--from "path:$_devenv_config")

  # Undo the older symlink-based attachment. Under --from, a devenv.yaml here
  # would load on top of the config's own and import everything twice.
  for _devenv_f in devenv.yaml devenv.nix .devenv; do
    if [[ -L "$_devenv_f" && "$(readlink -- "$_devenv_f")" == "$_devenv_configs"/* ]]; then
      rm -- "$_devenv_f"
    fi
  done

  # Under --from, devenv resolves this directory's own pins rather than using
  # the config's devenv.lock, so copy the config's lock whenever it changes.
  watch_file "$_devenv_config/devenv.lock"
  if [[ ! -f devenv.lock || "$_devenv_config/devenv.lock" -nt devenv.lock ]]; then
    cp -- "$_devenv_config/devenv.lock" devenv.lock
  fi
fi

# Remove devenv-generated symlinks (.pre-commit-config.yaml,
# .claude/settings.json, ...) whose store path was garbage-collected; devenv
# regenerates them. Only links into /nix/store are touched.
for _devenv_f in .[!.]* * .claude/*; do
  if [[ -L "$_devenv_f" && ! -e "$_devenv_f" && "$(readlink -- "$_devenv_f")" == /nix/store/* ]]; then
    log_status "removing dead link $_devenv_f (garbage-collected; will be regenerated)"
    rm -- "$_devenv_f"
  fi
done

unset _devenv_self _devenv_shared _devenv_configs _devenv_config _devenv_link _devenv_f

eval "$(devenv direnvrc)"
use devenv "${devenv_args[@]}" "$@"
